# Application
APPLICATION_NAME=support-ticket-system
APPLICATION_ENVIRONMENT=local
APPLICATION_DEBUG=true

# PostgreSQL (same values as docker-compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ticket_admin
POSTGRES_PASSWORD=ticket_secret_change_me
POSTGRES_DATABASE=ticket_system

# JWT (change in real deploy)
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Logging
LOG_LEVEL=INFO
