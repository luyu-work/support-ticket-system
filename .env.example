# Application
APPLICATION_NAME=support-ticket-system
APPLICATION_ENVIRONMENT=local
APPLICATION_DEBUG=true

# --- Database ---
# Option A (no Docker): local SQLite file
DATABASE_URL_OVERRIDE=sqlite:///./ticket_system_local.db
# Option B (Docker Postgres): leave DATABASE_URL_OVERRIDE empty/commented
# DATABASE_URL_OVERRIDE=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ticket_admin
POSTGRES_PASSWORD=ticket_secret_change_me
POSTGRES_DATABASE=ticket_system

# JWT (change in real deploy)
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Default staff (created on API startup if missing)
SEED_STAFF_ON_STARTUP=true
SEED_ADMIN_EMAIL=root@gmail.com
SEED_ADMIN_PASSWORD=root
SEED_ADMIN_FULL_NAME=Харисов Данил Мансурович
SEED_AGENT_EMAIL=agent_1@gmail.com
SEED_AGENT_PASSWORD=agent_1
SEED_AGENT_FULL_NAME=Денисов Игорь Сергеевич

# Logging
LOG_LEVEL=INFO
